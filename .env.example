# Copy this file to .env and fill in your keys.
# The app works WITHOUT keys too — it falls back to mock responses,
# so you can test and demo the policy engine with zero cost. For the
# "connects to a real LLM provider" production-readiness criterion,
# set at least one real key below.

GROQ_API_KEY=
GEMINI_API_KEY=

PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of allowed origins for CORS in production.
# Leave unset locally (defaults to allow-all).
# ALLOWED_ORIGINS=https://your-frontend.example.com

# --- Audit log backend -------------------------------------------------
# file      (default) — JSON file on local disk. Fine for local dev and
#           single-instance deployments; NOT safe for multiple ECS
#           tasks/Lambda instances, since each has its own filesystem.
# dynamodb  — real persisted, concurrency-safe state for AWS. Requires
#           AWS credentials in the environment (IAM role in ECS/Lambda,
#           or local AWS CLI credentials for testing) and a table
#           created via deploy/create-dynamodb-table.sh.
AUDIT_STORE=file
AUDIT_TABLE_NAME=guardrail-audit-log
AWS_REGION=us-east-1
